{
  "name": "masterwhats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/split_data.py && node scripts/export.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "split-data": "python3 scripts/split_data.py",
    "export": "node scripts/export.mjs",
    "prerender": "node scripts/prerender.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "verify": "npm run build && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "html2canvas": "^1.4.1",
    "mcp-handler": "^2.1.1",
    "zod": "^4.5.4"
  }
}
